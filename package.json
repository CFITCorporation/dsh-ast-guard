{
  "name": "@cfitsec/dsh-ast-guard",
  "version": "2.0.1",
  "description": "PowerShell syntax-tree guard for DSH: a resident parser plus its own rule file. Judges pwsh commands by syntax tree (not by text), and adds a deliberation tier for costly-but-legitimate actions.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "powershell",
    "command-guard",
    "syntax-tree",
    "safety"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CFITCorporation/dsh-ast-guard.git"
  },
  "homepage": "https://github.com/CFITCorporation/dsh-ast-guard#readme",
  "bugs": {
    "url": "https://github.com/CFITCorporation/dsh-ast-guard/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "rules",
    "test",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/hook.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "license": "MIT",
  "author": "CFITSec",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "profiles": [
        "web"
      ]
    }
  }
}
