{
  "name": "@cfitsec/dsh-ast-guard",
  "version": "0.1.0",
  "description": "PowerShell syntax-tree guard for DSH: a resident parser plus its own rule file. Judges pwsh commands by syntax tree (not by text), and adds a deliberation tier for costly-but-legitimate actions.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "rules",
    "test",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/hook.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "license": "MIT",
  "author": "CFITSec",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "profiles": [
        "web"
      ]
    }
  }
}
